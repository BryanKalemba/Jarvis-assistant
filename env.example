# Rename this file to .env and fill in your key
# Get a FREE key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: change the model or assistant name
# Check https://ai.google.dev/gemini-api/docs/models for current free-tier models
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_NAME=Jarvis

# Optional: free key from https://openweathermap.org/api, needed for get_weather
WEATHER_API_KEY=
